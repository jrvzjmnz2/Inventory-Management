# Copy this file to ".env" before running the app.

# MongoDB connection string (Atlas mongodb+srv:// URI, or a local
# mongodb://localhost:27017 URI if you're running MongoDB yourself).
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=<yourAppName>

# Name of the database to use on that cluster/instance.
MONGO_DB_NAME=inventory

# Port the Express server will run on.
PORT=3000

# --- SSO / session (added for AI Hub integration) ---
SSO_SHARED_SECRET=<same random value as the AI Hub's SSO_SHARED_SECRET>
SESSION_SECRET=<a different random value, local to this app only>
HUB_URL=http://localhost:5173
